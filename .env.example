# Copie ce fichier en .env et colle tes clés (gratuites).
# Pexels   : https://www.pexels.com/api/  (bouton "Your API key")
PEXELS_API_KEY=
# Pixabay  : https://pixabay.com/api/docs/  (connecté, la clé s'affiche dans la doc)
PIXABAY_API_KEY=
# Jamendo  : https://devportal.jamendo.com/  (créer une app -> Client ID)
JAMENDO_CLIENT_ID=
